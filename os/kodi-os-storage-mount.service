[Unit]
Description=Kodi OS removable storage automount
After=udisks2.service kodi-os-storage-init.service
Wants=kodi-os-storage-init.service

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'lsblk -pnro PATH,TYPE | awk '\''$2=="part"{print $1}'\'' | while read -r dev; do /usr/sbin/kodi-os-storage-mount "$dev" || true; done'
RemainAfterExit=no
