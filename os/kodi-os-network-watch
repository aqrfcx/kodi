#!/usr/bin/env bash
set -Eeuo pipefail

RUN_DIR=/run/kodi-os
STATE="$RUN_DIR/network"
mkdir -p "$RUN_DIR"

while :; do
  if command -v nmcli >/dev/null 2>&1; then
    state="$(nmcli -t -f GENERAL.STATE general 2>/dev/null | head -n1 || true)"
    connectivity="$(nmcli -t -f CONNECTIVITY general 2>/dev/null | head -n1 || true)"
    interfaces="$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null || true)"
    {
      printf 'status=ready\n'
      printf 'state=%s\n' "${state:-unknown}"
      printf 'connectivity=%s\n' "${connectivity:-unknown}"
      printf '%s\n' "$interfaces"
    } > "$STATE"
  else
    printf 'status=unavailable\n' > "$STATE"
  fi
  chmod 0644 "$STATE"
  sleep 5
done
