#!/usr/bin/env bash
set -Eeuo pipefail

STORAGE=/storage
install -d -m 0755 "$STORAGE"
for dir in userdata media state roms downloads saves screenshots bios; do
  install -d -m 0755 "$STORAGE/$dir"
done
install -d -m 0755 "$STORAGE/userdata/.kodi"

if id kodi >/dev/null 2>&1; then
  chown -R kodi:kodi "$STORAGE"
fi

# Keep Kodi userdata on persistent storage. Never delete user data during init.
if [[ -L /home/kodi/.kodi ]]; then
  target="$(readlink /home/kodi/.kodi)"
  if [[ "$target" != "$STORAGE/userdata/.kodi" ]]; then
    rm -f /home/kodi/.kodi
    ln -s "$STORAGE/userdata/.kodi" /home/kodi/.kodi
  fi
elif [[ -e /home/kodi/.kodi ]]; then
  if [[ -d /home/kodi/.kodi && -z "$(ls -A "$STORAGE/userdata/.kodi" 2>/dev/null)" ]]; then
    cp -a /home/kodi/.kodi/. "$STORAGE/userdata/.kodi/"
  fi
  mv /home/kodi/.kodi "/home/kodi/.kodi.migrated.$(date +%s)"
  ln -s "$STORAGE/userdata/.kodi" /home/kodi/.kodi
else
  ln -s "$STORAGE/userdata/.kodi" /home/kodi/.kodi
fi

if id kodi >/dev/null 2>&1; then
  chown -h kodi:kodi /home/kodi/.kodi
  chown -R kodi:kodi "$STORAGE/userdata/.kodi"
fi
