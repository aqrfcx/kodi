[Unit]
Description=Kodi OS first boot initialization
After=local-fs.target systemd-tmpfiles-setup.service
Before=kodi-os-session.service
ConditionPathExists=!/storage/.kodi-os-initialized

[Service]
Type=oneshot
ExecStart=/usr/sbin/kodi-os-firstboot
TimeoutStartSec=120
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
